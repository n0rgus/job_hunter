# --- Python bytecode / caches ---
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.cpython-*.pyc

# --- Logs ---
*.log

# --- Local runtime / scratch ---
runtime/
.runtime/
debug_pages/
scrape_progress.json

# --- Local DB (do not version) ---
job_hunt.db
*.sqlite
*.sqlite3
*.db

# --- Project folders you explicitly don't want tracked ---
/_input/
/_automation/
/_docs/

# --- Optional: common Python tooling ---
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/
ruff_cache/
dist/
build/
*.egg-info/

# --- Local runtime / debug artefacts (keep out of git) ---
__pycache__/
**/__pycache__/
*.pyc
*.cpython-*.pyc
